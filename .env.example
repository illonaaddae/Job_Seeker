# Copy to .env and fill in what you need. Everything is optional except the
# pieces used by the stage you are actually running.
# .env is git ignored. Never commit real values.

# ---------------------------------------------------------------- who you are
PROFILE_PATH=data/profile.illona.json

# ------------------------------------------------------------------- drafting
# With a key, Claude writes each letter against the job description.
# Without one, the deterministic template writer is used and everything still
# works, including the no dash and no filler rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
WRITER=auto                       # auto | claude | template

# --------------------------------------------------------------------- email
# Gmail needs 2 step verification and a 16 character app password, not your
# account password: https://myaccount.google.com/apppasswords
SENDER_EMAIL=
SENDER_NAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
REPLY_TO_EMAIL=

# Reading replies back in, so follow ups stop once someone answers.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------------------- cv
# master   attach your own CV file, the one named in the profile's documents
#          section. This is the default: it is the document you wrote and
#          stand behind.
# tailored generate a CV per job, reordering your skills to lead with what the
#          posting asks for. The facts never change, only their order.
CV_MODE=master

# ------------------------------------------------------------- autonomy
# How much the engine is allowed to do without you.
#
# AUTO_APPROVE_SCORE: approve drafts at or above this match score without a
#   human. Unset or 0 means every application waits for you, which is the
#   default. Set it to something high, 78 or more, before trusting it.
# AUTO_REPLY: off | draft | send. "draft" writes an answer and queues it for
#   you, which is the default. "send" answers straightforward replies by itself
#   and still queues anything about salary, timing, offers or scheduling.
# DIGEST_TO: where the daily summary goes.
AUTO_APPROVE_SCORE=0
AUTO_REPLY=draft
DIGEST_TO=
DASHBOARD_URL=

# ---------------------------------------------------------------- guardrails
# The master switch. Nothing is ever sent for real while this is false.
SEND_ENABLED=false
DAILY_SEND_CAP=12
PER_COMPANY_COOLDOWN_DAYS=45
MIN_SCORE_TO_DRAFT=55
MIN_SCORE_TO_SEND=62
FOLLOWUP_DAYS=6,14

# ----------------------------------------------------------------- discovery
DEFAULT_SOURCES=greenhouse,lever,ashby,workable
BOARDS_PATH=data/boards.json

# Optional, only for the cold outreach path to companies with no public board.
EXA_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=
APIFY_API_TOKEN=

# ------------------------------------------------------------------- storage
DB_PATH=data/jobseeker.db
LETTERS_DIR=generated/letters
CV_DIR=generated/cv

# ----------------------------------------------------------------- dashboard
# Required whenever the API listens on anything other than localhost.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
