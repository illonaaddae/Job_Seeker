# Keep the build context small and never bake local state or secrets into an image.
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc

.env
.env.*
!.env.example

# Local database and generated documents live on the mounted volume, not the image.
data/*.db
data/*.db-wal
data/*.db-shm
generated/

dashboard/node_modules
dashboard/dist
dashboard/.vite

legacy
tests
deploy/*.md
*.md
!README.md

.DS_Store
**/.DS_Store
